import pandas as pd
import streamlit as st

DATA_URL = "https://raw.githubusercontent.com/greatsong/modudata/main/data/seoul.csv"

# 데이터 불러오기
df = pd.read_csv(DATA_URL, encoding="utf-8-sig")

# 날짜와 기온 데이터 정리
df["날짜"] = pd.to_datetime(df["날짜"])
df["평균기온"] = pd.to_numeric(df["평균기온"], errors="coerce")

# 연도 추출
df["연도"] = df["날짜"].dt.year

# 연도별 연평균 기온 계산
annual = (
    df.dropna(subset=["평균기온"])
      .groupby("연도")["평균기온"]
      .mean()
      .reset_index()
)

# 최근 100년 선택
end_year = annual["연도"].max()
start_year = end_year - 99

annual_100 = annual[
    annual["연도"].between(start_year, end_year)
].copy()

# 그래프용 데이터
annual_100["연도"] = annual_100["연도"].astype(str)
chart_data = annual_100.set_index("연도")

# 화면
st.title("서울의 연평균 기온 변화")
st.subheader(f"{start_year}~{end_year}년")

st.line_chart(
    chart_data,
    y="평균기온",
    x_label="연도",
    y_label="연평균 기온 (°C)",
    height=500
)
